# Порт сервера
PORT=3000

# ---------- Telegram ----------
# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=
# ID чату / групи / каналу, куди слати заявки. Кілька — через кому.
# Дізнатися свій ID: напишіть боту @userinfobot. Для групи ID починається з -100...
TELEGRAM_CHAT_ID=

# ---------- Пошта (SMTP) ----------
# Gmail: smtp.gmail.com, 465, SMTP_SECURE=true, пароль — "пароль застосунку" (App Password)
# Ukr.net: smtp.ukr.net, 465, SMTP_SECURE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=glassifi.ua@gmail.com
SMTP_PASS=
# Від кого лист (зазвичай = SMTP_USER)
MAIL_FROM=glassifi.ua@gmail.com
# Куди слати заявки. Кілька — через кому.
MAIL_TO=glassifi.ua@gmail.com
